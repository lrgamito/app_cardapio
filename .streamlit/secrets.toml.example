# Copie este arquivo para `.streamlit/secrets.toml` e defina suas credenciais.
# As credenciais também podem ser fornecidas pelas variáveis de ambiente
# `APP_AUTH_USERNAME` e `APP_AUTH_PASSWORD`. Sem uma das duas fontes, são
# usados os padrões de desenvolvimento: `admin` / `admin`.
[auth]
username = "admin"
password = "mude-esta-senha"